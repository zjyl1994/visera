{
  "name": "visera",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  },
  "scripts": {
    "dev": "tsx watch server/index.ts --dev --config config.toml",
    "start": "node dist/server/index.js --config config.toml",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/**/*.test.ts",
    "build": "tsc && corepack pnpm --dir web build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.8",
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "iron-session": "^8.0.4",
    "multer": "^2.0.2",
    "openai": "^5.22.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "react-router-dom": "^7.9.4",
    "p-queue": "^8.1.0",
    "p-retry": "^6.2.1",
    "bottleneck": "^2.19.5",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.3",
    "smol-toml": "^1.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/multer": "^2.0.0",
    "drizzle-kit": "^0.31.4",
    "@playwright/test": "^1.55.0",
    "msw": "^2.10.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
